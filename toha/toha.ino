// ====== SPLASH ANIMASI ======
static inline float clamp01(float x) { return x < 0 ? 0 : (x > 1 ? 1 : x); }
static inline float easeOutCubic(float p) { float q = 1.0f - p; return 1.0f - q * q * q; }

void showSplash() {
  // Container hitam full-screen (mudah dihapus setelah selesai)
  lv_obj_t *cont = lv_obj_create(lv_scr_act());
  lv_obj_set_size(cont, SCREEN_W, SCREEN_H);
  lv_obj_set_pos(cont, 0, 0);
  lv_obj_set_style_bg_color(cont, lv_color_black(), 0);
  lv_obj_set_style_bg_opa(cont, LV_OPA_COVER, 0);
  lv_obj_set_style_border_width(cont, 0, 0);
  lv_obj_set_style_radius(cont, 0, 0);
  lv_obj_set_style_pad_all(cont, 0, 0);
  lv_obj_clear_flag(cont, LV_OBJ_FLAG_SCROLLABLE);

  // Teks "toha"
  lv_obj_t *lbl = lv_label_create(cont);
  lv_label_set_text(lbl, "toha");
  lv_obj_set_style_text_font(lbl, &lv_font_montserrat_48, 0);
  lv_obj_set_style_text_color(lbl, lv_color_hex(0xE8D0FF), 0);
  lv_obj_set_style_text_opa(lbl, LV_OPA_TRANSP, 0);
  lv_obj_align(lbl, LV_ALIGN_CENTER, 0, -6);

  // Garis bawah ungu yang melebar
  lv_obj_t *line = lv_obj_create(cont);
  lv_obj_set_height(line, 4);
  lv_obj_set_width(line, 0);
  lv_obj_set_style_bg_color(line, lv_color_hex(0x9B5CFF), 0);
  lv_obj_set_style_bg_opa(line, LV_OPA_TRANSP, 0);
  lv_obj_set_style_border_width(line, 0, 0);
  lv_obj_set_style_radius(line, 2, 0);
  lv_obj_set_style_pad_all(line, 0, 0);
  lv_obj_clear_flag(line, LV_OBJ_FLAG_SCROLLABLE);
  lv_obj_align(line, LV_ALIGN_CENTER, 0, 32);

  const uint32_t DUR = 2000;
  uint32_t t0 = millis();
  uint32_t t;
  do {
    t = millis() - t0;

    // Teks: fade + slide naik (0..600ms)
    float p1 = clamp01((float)t / 600.0f);
    float e1 = easeOutCubic(p1);
    int yoff = (int)(-6.0f + (1.0f - e1) * 18.0f);   // +12 -> -6
    lv_obj_align(lbl, LV_ALIGN_CENTER, 0, yoff);

    // Underline melebar (300..900ms)
    float p2 = clamp01(((float)t - 300.0f) / 600.0f);
    float e2 = easeOutCubic(p2);
    lv_obj_set_width(line, (int)(140.0f * e2));

    // Opacity masuk lalu keluar
    lv_opa_t opa;
    if (t < 600)        opa = (lv_opa_t)(255.0f * e1);
    else if (t < 1500)  opa = 255;
    else                opa = (lv_opa_t)(255.0f * (1.0f - clamp01(((float)t - 1500.0f) / 500.0f)));
    lv_obj_set_style_text_opa(lbl, opa, 0);
    lv_obj_set_style_bg_opa(line, opa, 0);

    lv_tick_handler();
    lv_timer_handler();
    delay(8);
  } while (t < DUR);

  lv_obj_del(cont);   // bersihkan splash sebelum UI utama
  lv_tick_handler();
  lv_timer_handler();
}

